# Copy to server/.env and adjust. server/.env is gitignored.
# Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://lee:lee_dev_password@localhost:5432/lee_tools"
# Separate database used by `npm test` (it is wiped on every test run).
TEST_DATABASE_URL="postgresql://lee:lee_dev_password@localhost:5432/lee_tools_test"
PORT=4000
# Set to "production" behind HTTPS so the session cookie gets the Secure flag.
NODE_ENV=development
