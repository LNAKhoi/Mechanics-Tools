generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           Int            @id @default(autoincrement())
  slug         String         @unique
  name         String
  brand        String
  sku          String         @unique
  description  String         @default("")
  /// VND. Never returned by public endpoints (CAP-1).
  price        Int
  stock        Int            @default(0)
  isBestseller Boolean        @default(false)
  /// Array of { label: string, value: string }.
  specs        Json           @default("[]")
  categoryId   Int
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ProductImage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  permissions String[]
  admins      AdminUser[]
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive     Boolean   @default(true)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// `id` is the SHA-256 hash of the cookie token, so a database leak does not leak live sessions.
model Session {
  id          String    @id
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  linkUrl   String?
  placement String
  sortOrder Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, isEnabled, sortOrder])
}

model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  html      String   @default("")
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             Int    @id @default(1)
  address        String
  hotlines       Json
  email          String
  zaloUrl        String?
  messengerUrl   String?
  mapEmbedUrl    String
  stores         Json
}

model Popup {
  id        Int      @id @default(1)
  title     String
  html      String   @default("")
  imageUrl  String?
  linkUrl   String?
  isEnabled Boolean  @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}
